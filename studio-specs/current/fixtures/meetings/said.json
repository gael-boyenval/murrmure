{
  "description": "said to one seat — one delivered receipt; other seats idle",
  "http": {
    "method": "POST",
    "path": "/v1/spaces/spc_app/events",
    "body": {
      "event_type": "mrmr.meeting.said",
      "session_id": "ses_meeting",
      "payload": {
        "as_participant_id": "ptc_designer",
        "to": { "participant_ids": ["ptc_researcher"] },
