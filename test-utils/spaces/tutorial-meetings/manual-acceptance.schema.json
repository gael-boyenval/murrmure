{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murrmure.dev/schemas/tutorial-meetings-manual-acceptance.json",
  "title": "Tutorial 1b meetings manual acceptance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "tutorial_chapters",
    "environment",
    "product_build",
    "commands",
    "space_ids",
    "connection_ids",
    "session_ids",
    "run_ids",
    "evidence",
    "result",
    "blockers"
  ],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "tutorial_chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 },
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "node", "execution"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "execution": {
          "enum": ["source", "packaged-desktop", "signed-release"]
        }
      }
    },
    "product_build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "artifact": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "output_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "space_ids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "pattern": "^spc_" },
      "uniqueItems": true
    },
    "connection_ids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "pattern": "^con_" },
      "uniqueItems": true
    },
    "session_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ses_" },
      "uniqueItems": true
    },
    "run_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^run_" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "enum": ["log", "screenshot", "journal", "artifact", "commit", "check"]
          },
          "ref": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" }
        }
      }
    },
    "result": { "enum": ["passed", "failed", "blocked"] },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
